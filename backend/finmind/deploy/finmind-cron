# FinceptWeb99 Taiwan FinMind clone — /etc/cron.d configuration.
#
# Install (root, one time):
#   install -m 0644 backend/finmind/deploy/finmind-cron \
#     /etc/cron.d/finceptweb99-finmind-tw
#
# This is deliberately market-wide only. The current tw_stock_info table
# contains an unsafe over-broad per-symbol universe, so automated fan-out
# stays disabled until that universe is repaired and independently bounded.
# `--skip-per-symbol` is enforced before ingest; `--tw-only` excludes crypto
# and non-Taiwan macro datasets. The lock prevents overlapping Taiwan sweeps.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Price/volume settle after the 13:30 close.
10 15 * * 1-5 root cd /opt/finceptweb99 && /usr/bin/flock -n /opt/finceptweb99/var/finmind99-tw.lock /usr/local/bin/docker-compose -p finceptweb99 exec -T backend python -m finmind.scripts.run_due --tw-only --skip-per-symbol >> /var/log/finmind99-tw.log 2>&1
# Institutional, margin, and securities-lending datasets publish later.
30 17 * * 1-5 root cd /opt/finceptweb99 && /usr/bin/flock -n /opt/finceptweb99/var/finmind99-tw.lock /usr/local/bin/docker-compose -p finceptweb99 exec -T backend python -m finmind.scripts.run_due --tw-only --skip-per-symbol >> /var/log/finmind99-tw.log 2>&1
# Derivatives after-hours and any weekly/monthly Taiwan rollups.
0 22 * * 1-5 root cd /opt/finceptweb99 && /usr/bin/flock -n /opt/finceptweb99/var/finmind99-tw.lock /usr/local/bin/docker-compose -p finceptweb99 exec -T backend python -m finmind.scripts.run_due --tw-only --skip-per-symbol >> /var/log/finmind99-tw.log 2>&1
