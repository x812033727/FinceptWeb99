{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.3.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Core Web Vitals (LCP / INP / CLS / FCP / TTFB) reported by the browser via /api/system/web-vital. p75 is the threshold metric Google uses to classify a route as good / needs-improvement / poor.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "p75 — Google's threshold metric",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2.5 },
            { "color": "red", "value": 4.0 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"LCP\"}[5m])) by (le))",
          "legendFormat": "LCP p75",
          "refId": "A"
        }
      ],
      "title": "LCP p75",
      "description": "Largest Contentful Paint. Good < 2.5 s, poor >= 4 s.",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.2 },
            { "color": "red", "value": 0.5 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"INP\"}[5m])) by (le))",
          "legendFormat": "INP p75",
          "refId": "A"
        }
      ],
      "title": "INP p75",
      "description": "Interaction to Next Paint. Good < 200 ms, poor >= 500 ms.",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.1 },
            { "color": "red", "value": 0.25 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_score_bucket{name=\"CLS\"}[5m])) by (le))",
          "legendFormat": "CLS p75",
          "refId": "A"
        }
      ],
      "title": "CLS p75",
      "description": "Cumulative Layout Shift. Good < 0.1, poor >= 0.25. Unitless.",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1.8 },
            { "color": "red", "value": 3.0 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"FCP\"}[5m])) by (le))",
          "legendFormat": "FCP p75",
          "refId": "A"
        }
      ],
      "title": "FCP p75",
      "description": "First Contentful Paint. Good < 1.8 s.",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.8 },
            { "color": "red", "value": 1.8 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"TTFB\"}[5m])) by (le))",
          "legendFormat": "TTFB p75",
          "refId": "A"
        }
      ],
      "title": "TTFB p75",
      "description": "Time to First Byte. Good < 0.8 s.",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Trends — distribution over time",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 6,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(web_vital_seconds_bucket{name=\"LCP\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"LCP\"}[5m])) by (le))",
          "legendFormat": "p75",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(web_vital_seconds_bucket{name=\"LCP\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "C"
        }
      ],
      "title": "LCP — p50 / p75 / p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 7,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(web_vital_seconds_bucket{name=\"INP\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"INP\"}[5m])) by (le))",
          "legendFormat": "p75",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(web_vital_seconds_bucket{name=\"INP\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "C"
        }
      ],
      "title": "INP — p50 / p75 / p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 8,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(web_vital_score_bucket{name=\"CLS\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_score_bucket{name=\"CLS\"}[5m])) by (le))",
          "legendFormat": "p75",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(web_vital_score_bucket{name=\"CLS\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "C"
        }
      ],
      "title": "CLS — p50 / p75 / p95 (unitless)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 9,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(web_vital_seconds_count[1m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(web_vital_score_count[1m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "B"
        }
      ],
      "title": "Beacon Volume — sanity check",
      "description": "If this is flat at zero the frontend reporter is broken or PROD env var isn't set.",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "Per-route breakdown (LCP p75)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "id": 10,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum(rate(web_vital_seconds_bucket{name=\"LCP\"}[5m])) by (le, path))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "title": "LCP p75 per route — find the slow pages",
      "description": "One line per page (path label is normalized to one of ~13 route shapes by the backend, so cardinality is bounded).",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["web-vitals", "frontend", "performance"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Fincept Web Terminal — Core Web Vitals",
  "uid": "fincept-web-vitals",
  "version": 1
}
