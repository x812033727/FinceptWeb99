# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=finceptweb
POSTGRES_USER=fincept
# REPLACE — never commit this value. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────
# Leave blank to disable auth (dev only); set in production
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────
# REPLACE. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_token_hex_32
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Initial Admin Account (created on first boot if both are set) ──
# Leave blank in production and create the admin via a one-shot CLI/job
# instead — committing a plaintext password to .env is a foot-gun.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── US Market Data ────────────────────────────────────────────────
# Polygon.io — free tier at polygon.io/dashboard (falls back to yfinance)
POLYGON_API_KEY=

# yfinance is free and requires no key
YAHOO_FINANCE_ENABLED=true

# FRED (Federal Reserve) — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Taiwan Market Data ────────────────────────────────────────────
# FinMind — free tier (600 req/day) at finmindtrade.com (falls back to TWSE)
FINMIND_TOKEN=

# TWSE OpenAPI is free and requires no key
TWSE_API_ENABLED=true

# ── AI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama local LLM (set to "" to disable)
OLLAMA_HOST=http://ollama:11434

# Default provider: openai | anthropic | gemini | ollama
DEFAULT_LLM_PROVIDER=openai

# ── Auto-update / GitHub release polling ─────────────────────────
# Backend polls GitHub Releases every UPDATE_CHECK_INTERVAL_HOURS to
# surface "update available" in the UI. Defaults point at this repo.
GITHUB_OWNER=x812033727
GITHUB_REPO=FinceptWeb
UPDATE_CHECK_INTERVAL_HOURS=6
# Argv list run by POST /api/admin/update (admin-only). Empty = endpoint
# returns "not_configured". JSON-encoded list — no shell is spawned, so
# `&&`/pipes are NOT supported. Wrap multi-step updates in a script and
# add the script path to UPDATE_COMMAND_ALLOWLIST.
# Example: UPDATE_COMMAND=["docker","compose","pull"]
UPDATE_COMMAND=
# Comma-separated allowlist matched against argv[0] (basename or full path).
UPDATE_COMMAND_ALLOWLIST=docker,docker-compose,kubectl,helm,/usr/local/bin/update.sh

# ── Observability ─────────────────────────────────────────────────
# Restrict /metrics scraping. Default = loopback only. Either widen the
# CIDR list to include your Prometheus scraper, or set METRICS_AUTH_TOKEN
# and configure Prometheus with `Authorization: Bearer <token>`.
METRICS_ALLOW_CIDRS=127.0.0.1/32,::1/128
METRICS_AUTH_TOKEN=

# Grafana admin password (compose). REQUIRED — compose now refuses to
# start with the default. Set to a long random string.
GRAFANA_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── Server ────────────────────────────────────────────────────────
HTTP_PORT=80
