# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=finceptweb
POSTGRES_USER=fincept
POSTGRES_PASSWORD=change_me_in_production

# SQLAlchemy async URL (used inside containers)
DATABASE_URL=postgresql+asyncpg://fincept:change_me_in_production@postgres:5432/finceptweb

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── US Market Data ────────────────────────────────────────────────
# Polygon.io — free tier at polygon.io/dashboard
POLYGON_API_KEY=

# yfinance is free and requires no key
YAHOO_FINANCE_ENABLED=true

# FRED (Federal Reserve) — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Taiwan Market Data ────────────────────────────────────────────
# FinMind — free tier (600 req/day) at finmindtrade.com
FINMIND_TOKEN=

# TWSE OpenAPI is free and requires no key
TWSE_API_ENABLED=true

# ── AI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama local LLM (optional)
OLLAMA_HOST=http://localhost:11434

# ── Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256

# ── Initial Admin Account (created on first boot if both are set) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Server ────────────────────────────────────────────────────────
HTTP_PORT=80
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
