# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=finceptweb
POSTGRES_USER=fincept
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────
# Leave blank to disable auth (dev only); set in production
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_real_secret
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Initial Admin Account (created on first boot if both are set) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_change_me

# ── US Market Data ────────────────────────────────────────────────
# Polygon.io — free tier at polygon.io/dashboard (falls back to yfinance)
POLYGON_API_KEY=

# yfinance is free and requires no key
YAHOO_FINANCE_ENABLED=true

# FRED (Federal Reserve) — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Taiwan Market Data ────────────────────────────────────────────
# FinMind — free tier (600 req/day) at finmindtrade.com (falls back to TWSE)
FINMIND_TOKEN=

# TWSE OpenAPI is free and requires no key
TWSE_API_ENABLED=true

# ── AI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama local LLM (set to "" to disable)
OLLAMA_HOST=http://ollama:11434

# Default provider: openai | anthropic | gemini | ollama
DEFAULT_LLM_PROVIDER=openai

# ── Auto-update / GitHub release polling ─────────────────────────
# Backend polls GitHub Releases every UPDATE_CHECK_INTERVAL_HOURS to
# surface "update available" in the UI. Defaults point at this repo.
GITHUB_OWNER=x812033727
GITHUB_REPO=FinceptWeb
UPDATE_CHECK_INTERVAL_HOURS=6
# Shell run by POST /api/admin/update (admin-only). Empty = endpoint
# returns "not_configured". Typical compose deployment:
# UPDATE_COMMAND=docker compose pull && docker compose up -d backend frontend
UPDATE_COMMAND=

# ── Server ────────────────────────────────────────────────────────
HTTP_PORT=80
