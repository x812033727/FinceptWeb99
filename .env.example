# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=finceptweb
POSTGRES_USER=fincept
# REPLACE — never commit this value. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────
# Leave blank to disable auth (dev only); set in production
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────
# REPLACE. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_token_hex_32
JWT_ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Initial Admin Account (created on first boot if both are set) ──
# Leave blank in production and create the admin via a one-shot CLI/job
# instead — committing a plaintext password to .env is a foot-gun.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── US Market Data ────────────────────────────────────────────────
# Polygon.io — free tier at polygon.io/dashboard (falls back to yfinance)
POLYGON_API_KEY=

# yfinance is free and requires no key
YAHOO_FINANCE_ENABLED=true

# FRED (Federal Reserve) — free at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — 4th-tier US quote fallback. Free tier 60 req/min at
# finnhub.io/dashboard. Only used when Polygon / yfinance / Stooq all
# return empty (e.g. cloud-IP block + Stooq anti-scrape simultaneously).
# Empty key disables the connector with no behavioural change.
FINNHUB_API_KEY=

# ── Taiwan Market Data ────────────────────────────────────────────
# FinMind — free tier (600 req/day) at finmindtrade.com (falls back to TWSE)
FINMIND_TOKEN=

# TWSE OpenAPI is free and requires no key
TWSE_API_ENABLED=true

# ── FinMind Clone Subsystem ───────────────────────────────────────
# Two deployment paths for the FinMind paid-mirror service:
#
# Path A2 (default): shares the main DATABASE_URL with a `finmind`
#                    Postgres schema for isolation. Works for any
#                    single-Postgres deploy without extra containers.
# Path A1: runs in a separate `postgres_finmind` container. Needs
#          `docker compose --profile finmind up -d postgres_finmind`.
#          Set FINMIND_USE_MAIN_DB=false explicitly to opt in.
FINMIND_USE_MAIN_DB=true
# Lifespan auto-runs alembic + seed on backend startup. Set false for
# multi-pod deploys where only one pod should migrate.
FINMIND_AUTO_INIT=true
# Only consulted when FINMIND_USE_MAIN_DB=false. Leave blank to use the
# docker-compose default (`postgres_finmind:5432`); override only if
# pointing at a Postgres outside the compose network.
FINMIND_DATABASE_URL=

# Verify env-var propagation after editing this file:
#   docker compose restart backend
#   docker compose logs backend | grep "finmind config:"
# Expected line shows USE_MAIN_DB / effective_url / schema as set above.

# ── AI / LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama local LLM (set to "" to disable)
OLLAMA_HOST=http://ollama:11434

# MiniMax (OpenAI-compatible; cheap, strong Chinese, supports tool-use).
# International endpoint shown; mainland users: https://api.minimax.chat
MINIMAX_API_KEY=
MINIMAX_HOST=https://api.minimax.io
# Common model IDs: MiniMax-M2.7, MiniMax-M2.7-highspeed (faster, same quality),
# abab6.5s-chat (cheapest), abab6.5-chat, MiniMax-Text-01 (4M token context).
# Override per request via "model" body field.
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TURNS=6

# Groq (OpenAI-compatible; very fast inference, hundreds-thousands tok/s).
GROQ_API_KEY=
GROQ_HOST=https://api.groq.com/openai
# Tool-use capable: llama-3.3-70b-versatile, llama-3.1-70b-versatile,
# mixtral-8x7b-32768. Override per request via "model" body field.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TURNS=6

# DeepSeek (OpenAI-compatible; cheapest, strong numerical reasoning).
DEEPSEEK_API_KEY=
DEEPSEEK_HOST=https://api.deepseek.com
# Models: deepseek-chat (V3, fast), deepseek-reasoner (R1, with chain-of-thought).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TURNS=6

# OpenRouter (OpenAI-compatible meta-router; one key → 100+ models from
# OpenAI, Anthropic, Google, Mistral, Meta, etc. with fallback support).
OPENROUTER_API_KEY=
OPENROUTER_HOST=https://openrouter.ai/api
# Model id form: "<provider>/<model>", e.g. anthropic/claude-3.5-sonnet,
# google/gemini-pro, mistralai/mixtral-8x22b-instruct.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional analytics headers per OpenRouter's spec (leave empty if you don't care):
OPENROUTER_REFERER=
OPENROUTER_TITLE=
OPENROUTER_MAX_TURNS=6

# Default provider: openai | anthropic | gemini | ollama | minimax | groq | deepseek | openrouter
DEFAULT_LLM_PROVIDER=openai

# ── Claude Agent (optional, tool-use via claude-agent-sdk) ────────
# Auto-disabled when `claude-agent-sdk` is not installed; set to false
# to force-disable even when the SDK is present. analyst/admin only.
CLAUDE_AGENT_ENABLED=true
CLAUDE_AGENT_MODEL=claude-sonnet-4-5-20250929
CLAUDE_AGENT_MAX_TURNS=8
CLAUDE_AGENT_TOOL_TIMEOUT_S=30
CLAUDE_AGENT_PYTHON_MEM_MB=256
CLAUDE_AGENT_PYTHON_CPU_S=5
# Comma-separated host allowlist for the `web_fetch` tool. Empty = block all.
# Default covers GitHub raw, Anthropic / FastAPI docs, FRED, SEC, Yahoo chart.
CLAUDE_AGENT_WEBFETCH_ALLOWLIST=raw.githubusercontent.com,api.github.com,docs.anthropic.com,fastapi.tiangolo.com,api.stlouisfed.org,www.sec.gov,query1.finance.yahoo.com

# ── Auto-update / GitHub release polling ─────────────────────────
# Backend polls GitHub Releases every UPDATE_CHECK_INTERVAL_HOURS to
# surface "update available" in the UI. Defaults point at this repo.
GITHUB_OWNER=x812033727
GITHUB_REPO=FinceptWeb
UPDATE_CHECK_INTERVAL_HOURS=6
# Argv list run by POST /api/admin/update (admin-only). Empty = endpoint
# returns "not_configured". JSON-encoded list — no shell is spawned, so
# `&&`/pipes are NOT supported. Wrap multi-step updates in a script and
# add the script path to UPDATE_COMMAND_ALLOWLIST.
# Common configurations:
#   Docker Compose: UPDATE_COMMAND=["docker","compose","pull"]
#   Kubernetes:     UPDATE_COMMAND=["kubectl","rollout","restart","deployment/fincept-backend"]
#   Helm:           UPDATE_COMMAND=["helm","upgrade","fincept","./helm/fincept-web"]
#   Custom script:  UPDATE_COMMAND=["/usr/local/bin/update.sh"]
UPDATE_COMMAND=
# Comma-separated allowlist matched against argv[0] (basename or full path).
UPDATE_COMMAND_ALLOWLIST=docker,docker-compose,kubectl,helm,/usr/local/bin/update.sh

# ── Observability ─────────────────────────────────────────────────
# Restrict /metrics scraping. Default = loopback only. Either widen the
# CIDR list to include your Prometheus scraper, or set METRICS_AUTH_TOKEN
# and configure Prometheus with `Authorization: Bearer <token>`.
METRICS_ALLOW_CIDRS=127.0.0.1/32,::1/128
METRICS_AUTH_TOKEN=

# Grafana admin password (compose). REQUIRED — compose now refuses to
# start with the default. Set to a long random string.
GRAFANA_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ── SMTP (daily auto-run discussion email report) ─────────────────
# When a user opts into the daily auto-run discussion AND ticks
# "email me the report", the cron emails a Markdown report after the
# discussion concludes. Leaving SMTP_HOST or SMTP_FROM empty silently
# disables this feature deployment-wide — the auto-run task itself
# still runs successfully and the user can read the report in the
# DiscussionPage UI.
#
# Typical relays (set SMTP_USE_TLS=true, port=587):
#   Gmail:     SMTP_HOST=smtp.gmail.com   (app password, not account)
#   Mailgun:   SMTP_HOST=smtp.mailgun.org
#   AWS SES:   SMTP_HOST=email-smtp.<region>.amazonaws.com
# Implicit-TLS port 465 deployments: SMTP_USE_TLS=false, SMTP_USE_SSL=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# ── Server ────────────────────────────────────────────────────────
HTTP_PORT=80
