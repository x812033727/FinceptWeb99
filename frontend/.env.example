# Frontend environment variables.
#
# Vite only exposes vars prefixed with VITE_ to client-side code via
# `import.meta.env.VITE_*`. Anything else is build-time only.
#
# Copy to `.env` for local development (vite reads `.env`, `.env.local`,
# `.env.development`, etc. — see https://vite.dev/guide/env-and-mode.html).

# ── API base URL ──────────────────────────────────────────────────
# Leave unset to use the relative `/api` prefix (axios default), which
# works behind nginx in production and Vite's dev-server proxy locally.
# Override only when running the SPA against a remote backend.
# VITE_API_BASE_URL=http://localhost:8000/api

# ── WebSocket URL ─────────────────────────────────────────────────
# Same as above — relative path is preferred. Override only if the WS
# endpoint lives on a different host than the SPA.
# VITE_WS_URL=ws://localhost:8000/ws

# ── Feature flags (optional) ──────────────────────────────────────
# VITE_FEATURE_AI_TOOLS=true
